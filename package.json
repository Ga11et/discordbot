{
  "name": "discordbot",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart discordbot --update-env",
    "pm2:logs": "pm2 logs discordbot",
    "wsl:bootstrap": "bash scripts/wsl-pm2-bootstrap.sh"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "discord-api-types": "^0.37.76",
    "discord.js": "^14.26.3",
    "dotenv": "^16.4.7",
    "knex": "^3.2.9",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/knex": "^0.16.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.0.5"
  }
}
